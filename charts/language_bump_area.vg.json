{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Rise and Fall of World Languages on Screen",
    "subtitle": "Following the languages that shaped global film production",
    "anchor": "start",
    "fontSize": 30,
    "subtitleFontSize": 18,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Inter"
  },
  "width": 2000,
  "height": 900,
  "background": null,
  "padding": {"left": 10, "right": 110, "top": 20, "bottom": 30},
  "config": {
    "view": {"stroke": null},
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#1a1a1a",
      "titleColor": "#6b6258",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "grid": false
    }
  },
  "data": {
    "url": "data/language_bump_area.csv",
    "format": {
      "type": "csv",
      "parse": {
        "decade": "number",
        "rank": "number",
        "count": "number",
        "band_top": "number",
        "band_bottom": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone",
        "stroke": "white",
        "strokeWidth": 0.8,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "decade",
          "type": "quantitative",
          "scale": {"domain": [1970, 2020]},
          "axis": {
            "title": "Decade",
            "format": "d",
            "tickCount": 6
          }
        },
        "y": {
          "field": "band_bottom",
          "type": "quantitative",
          "scale": {"domain": [-0.5, 11.5]},
          "axis": null
        },
        "y2": {"field": "band_top"},
        "detail": {"field": "language", "type": "nominal"},
        "color": {
          "field": "language",
          "type": "nominal",
          "scale": {
            "domain": ["English", "French", "Italian", "Japanese", "Spanish", "German", "Korean", "Hindi", "Chinese", "Russian"],
            "range": ["#dda15e", "#355070", "#bb8588", "#ffe1a8", "#6A3D2A", "#8A7862", "#b8bedd", "#e07a5f", "#c44536", "#22223b"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "language", "type": "nominal", "title": "Language"},
          {"field": "decade", "type": "quantitative", "title": "Decade", "format": "d"},
          {"field": "rank", "type": "quantitative", "title": "Rank"},
          {"field": "count", "type": "quantitative", "title": "Number of Films", "format": ","}
        ]
      }
    },
    {
      "transform": [
        {"filter": "datum.decade == 2020"},
        {"calculate": "(datum.band_top + datum.band_bottom) / 2", "as": "label_y"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 8,
        "fontSize": 30,
        "fontWeight": 600
      },
      "encoding": {
        "x": {"field": "decade", "type": "quantitative"},
        "y": {
          "field": "label_y",
          "type": "quantitative",
          "scale": {"domain": [-0.5, 11.5]},
          "axis": null
        },
        "text": {"field": "language", "type": "nominal"},
        "color": {
          "field": "language",
          "type": "nominal",
          "scale": {
            "domain": ["English", "French", "Italian", "Japanese", "Spanish", "German", "Korean", "Hindi", "Chinese", "Russian"],
            "range": ["#7a2e3e", "#d65a1f", "#d4a017", "#3a4d6c", "#c98092", "#5a7fa5", "#2d6166", "#b08652", "#6b5a8a", "#9b9085"]
          },
          "legend": null
        }
      }
    },
    {
      "data": {
        "values": [
          {"x1": 1998, "y1": 2.5, "x2": 1990, "y2": 0.5}
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#6b6258",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "y": {"field": "y1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {"x1": 1980, "x2": 1997, "y1": -0.8, "y2": 0.7}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y1", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1988.5,
            "y": 0.4,
            "label": "Government investments in the film \nindustry during the late 1990s helped \nKorean cinema expand globally."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "middle",
        "fontSize": 10.5,
        "lineHeight": 14,
        "fill": "#6b6258",
        "font": "Inter",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}