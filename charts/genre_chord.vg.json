{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": " The Genre Web",
    "subtitle": "The most common genre partnerships in modern cinema",
    "anchor": "start",
    "fontSize": 30,
    "subtitleFontSize": 18,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Inter"
  },
  "width": 600,
  "height": 600,
  "background": null,
  "config": {
    "view": {"stroke": null},
    "font": "Inter"
  },
  "params": [
    {
      "name": "GenreFocus",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All","Drama","Comedy","Thriller","Action","Romance","Crime","Adventure","Horror","Science Fiction","Family"],
        "name": "Focus on Genre:  "
      }
    }
  ],
  "layer": [
    {
      "description": "Visible ribbons connecting genre pairs",
      "data": {
        "url": "data/chord_ribbons.csv",
        "format": {
          "type": "csv",
          "parse": {"x": "number", "y": "number", "point_order": "number", "pair_count": "number", "ribbon_id": "number"}
        }
      },
      "transform": [
        {"calculate": "min(0.7, 0.12 + (datum.pair_count / 2700) * 0.55)", "as": "ribbon_opacity"}
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 0,
        "fill": null
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 600]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [600, 0]}, "axis": null},
        "order": {"field": "point_order", "type": "quantitative"},
        "detail": {"field": "ribbon_id", "type": "nominal"},
        "fill": {
          "field": "dominant_genre",
          "type": "nominal",
          "scale": {
            "domain": ["Drama","Comedy","Thriller","Action","Romance","Crime","Adventure","Horror","Science Fiction","Family"],
            "range": ["#7a2e3e","#ffd380","#3a4d6c","#d65a1f","#c98092","#2d6166","#b08652","#2c2c2c","#5a7fa5","#7a8c4f"]
          },
          "legend": null
        },
        "fillOpacity": {
          "condition": {
            "test": "GenreFocus == 'All' || datum.genre_a == GenreFocus || datum.genre_b == GenreFocus",
            "field": "ribbon_opacity",
            "type": "quantitative"
          },
          "value": 0
        }
      }
    },
    {
      "description": "Invisible hover catcher — thick stroke for tooltip hit-testing",
      "data": {
        "url": "data/chord_ribbons.csv",
        "format": {
          "type": "csv",
          "parse": {"x": "number", "y": "number", "point_order": "number", "pair_count": "number", "ribbon_id": "number"}
        }
      },
      "transform": [
        {"calculate": "datum.dominant_genre", "as": "primary_genre"},
        {"calculate": "datum.genre_a == datum.dominant_genre ? datum.genre_b : datum.genre_a", "as": "secondary_genre"}
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 8,
        "stroke": "transparent",
        "fill": null
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 600]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [600, 0]}, "axis": null},
        "order": {"field": "point_order", "type": "quantitative"},
        "detail": {"field": "ribbon_id", "type": "nominal"},
        "opacity": {
          "condition": {
            "test": "GenreFocus == 'All' || datum.genre_a == GenreFocus || datum.genre_b == GenreFocus",
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {"field": "primary_genre", "type": "nominal", "title": "Primary genre"},
          {"field": "secondary_genre", "type": "nominal", "title": "Secondary genre"},
          {"field": "pair_count", "type": "quantitative", "title": "Films sharing both genres", "format": ","}
        ]
      }
    },
    {
      "description": "Arc segments around the perimeter",
      "data": {
        "url": "data/chord_arcs.csv",
        "format": {
          "type": "csv",
          "parse": {"x": "number", "y": "number", "point_order": "number", "total": "number"}
        }
      },
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 0,
        "fill": null
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 600]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [600, 0]}, "axis": null},
        "order": {"field": "point_order", "type": "quantitative"},
        "detail": {"field": "genre", "type": "nominal"},
        "fill": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": ["Drama","Comedy","Thriller","Action","Romance","Crime","Adventure","Horror","Science Fiction","Family"],
            "range": ["#7a2e3e","#d4a017","#3a4d6c","#d65a1f","#c98092","#2d6166","#b08652","#2c2c2c","#5a7fa5","#7a8c4f"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "genre", "type": "nominal", "title": "Genre"},
          {"field": "total", "type": "quantitative", "title": "Total co-occurrences with other genres", "format": ","}
        ]
      }
    },
    {
      "description": "Annotation connector to Thriller arc",
      "data": {
        "values": [
          {"x1": 420, "y1": 490, "x2": 420, "y2": 530}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative", "scale": {"domain": [0, 600]}, "axis": null},
        "y": {"field": "y1", "type": "quantitative", "scale": {"domain": [600, 0]}, "axis": null},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "description": "Annotation box for Thriller",
      "data": {
        "values": [
          {"x": 374, "x2": 573, "y": 530, "y2": 594}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 600]}, "axis": null},
        "x2": {"field": "x2"},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [600, 0]}, "axis": null},
        "y2": {"field": "y2"}
      }
    },
    {
      "description": "Annotation text for Thriller",
      "data": {
        "values": [
          {
            "x": 383,
            "y": 542,
            "label": "Thrillers often blend with crime,\ndrama and action because suspense\nintensifies existing stories rather\nthan standing alone."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 10.5,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 600]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [600, 0]}, "axis": null},
        "text": {"field": "label"}
      }
    },
    {
      "description": "Genre labels",
      "data": {
        "url": "data/chord_labels.csv",
        "format": {
          "type": "csv",
          "parse": {"label_x": "number", "label_y": "number"}
        }
      },
      "mark": {"type": "text", "fontSize": 13, "fontWeight": 600, "color": "#1a1a1a"},
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative", "scale": {"domain": [0, 600]}, "axis": null},
        "y": {"field": "label_y", "type": "quantitative", "scale": {"domain": [600, 0]}, "axis": null},
        "text": {"field": "genre", "type": "nominal"}
      }
    }
  ]
}