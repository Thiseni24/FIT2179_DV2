{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Genre Web",
    "subtitle": "Tracing which genres lead films and which more often play a supporting role",
    "anchor": "start",
    "fontSize": 30,
    "subtitleFontSize": 18,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Inter",
    "subtitleFontStyle": "italic"
  },
  "width": 800,
  "height": 800,
  "background": null,
  "config": {
    "view": {"stroke": null},
    "font": "Inter"
  },
  "params": [
    {
      "name": "GenreFocus",
      "value": "All",
      "bind": {
        "input": "select",
        "options": ["All","Drama","Comedy","Thriller","Action","Romance","Crime","Adventure","Horror","Science Fiction","Family"],
        "name": "Focus on Genre:  "
      }
    }
  ],
  "layer": [
    {
      "description": "Visible ribbons (coloured by source / 'from' genre)",
      "data": {
        "url": "data/chord_ribbons.csv",
        "format": {
          "type": "csv",
          "parse": {"x": "number", "y": "number", "point_order": "number", "pair_count": "number", "ribbon_id": "number"}
        }
      },
      "transform": [
        {"calculate": "min(0.78, 0.18 + (datum.pair_count / 1600) * 0.55)", "as": "ribbon_opacity"}
      ],
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 0,
        "fill": null
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 800]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [800, 0]}, "axis": null},
        "order": {"field": "point_order", "type": "quantitative"},
        "detail": {"field": "ribbon_id", "type": "nominal"},
        "fill": {
          "field": "from_genre",
          "type": "nominal",
          "scale": {
            "domain": ["Drama","Comedy","Thriller","Action","Romance","Crime","Adventure","Horror","Science Fiction","Family"],
            "range": ["#7a2e3e","#ffd380","#3a4d6c","#d65a1f","#c98092","#2d6166","#b08652","#2c2c2c","#5a7fa5","#7a8c4f"]
          },
          "legend": null
        },
        "fillOpacity": {
          "condition": {
            "test": "GenreFocus == 'All' || datum.from_genre == GenreFocus || datum.to_genre == GenreFocus",
            "field": "ribbon_opacity",
            "type": "quantitative"
          },
          "value": 0
        }
      }
    },
    {
      "description": "Invisible hover catcher for tooltips",
      "data": {
        "url": "data/chord_ribbons.csv",
        "format": {
          "type": "csv",
          "parse": {"x": "number", "y": "number", "point_order": "number", "pair_count": "number", "ribbon_id": "number"}
        }
      },
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 8,
        "stroke": "transparent",
        "fill": null
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 800]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [800, 0]}, "axis": null},
        "order": {"field": "point_order", "type": "quantitative"},
        "detail": {"field": "ribbon_id", "type": "nominal"},
        "opacity": {
          "condition": {
            "test": "GenreFocus == 'All' || datum.from_genre == GenreFocus || datum.to_genre == GenreFocus",
            "value": 1
          },
          "value": 0
        },
        "tooltip": [
          {"field": "from_genre", "type": "nominal", "title": "From (primary)"},
          {"field": "to_genre", "type": "nominal", "title": "To (secondary)"},
          {"field": "pair_count", "type": "quantitative", "title": "Films", "format": ","}
        ]
      }
    },
    {
      "description": "Arc segments (out and in halves per genre)",
      "data": {
        "url": "data/chord_arcs.csv",
        "format": {
          "type": "csv",
          "parse": {"x": "number", "y": "number", "point_order": "number", "total": "number", "arc_id": "number"}
        }
      },
      "mark": {
        "type": "line",
        "interpolate": "linear-closed",
        "strokeWidth": 0,
        "fill": null
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 800]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [800, 0]}, "axis": null},
        "order": {"field": "point_order", "type": "quantitative"},
        "detail": {"field": "arc_id", "type": "nominal"},
        "fill": {
          "field": "genre",
          "type": "nominal",
          "scale": {
            "domain": ["Drama","Comedy","Thriller","Action","Romance","Crime","Adventure","Horror","Science Fiction","Family"],
            "range": ["#7a2e3e","#d4a017","#3a4d6c","#d65a1f","#c98092","#2d6166","#b08652","#2c2c2c","#5a7fa5","#7a8c4f"]
          },
          "legend": null
        },
        "tooltip": [
          {"field": "genre", "type": "nominal", "title": "Genre"},
          {"field": "direction", "type": "nominal", "title": "Half"},
          {"field": "total", "type": "quantitative", "title": "Films", "format": ","}
        ]
      }
    },
    {
      "description": "Annotation connector — points at Romance's incoming arc",
      "data": {
        "values": [
          {"x1": 280, "y1": 420, "x2": 195, "y2": 555}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative", "scale": {"domain": [0, 800]}, "axis": null},
        "y": {"field": "y1", "type": "quantitative", "scale": {"domain": [800, 0]}, "axis": null},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "description": "Annotation box",
      "data": {
        "values": [
          {"x": 280, "x2": 560, "y": 340, "y2": 420}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 800]}, "axis": null},
        "x2": {"field": "x2"},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [800, 0]}, "axis": null},
        "y2": {"field": "y2"}
      }
    },
    {
      "description": "Annotation text",
      "data": {
        "values": [
          {
            "x": 290,
            "y": 380,
            "label": "Romance rarely leads. Most romantic\nfilms are primarily Drama or Comedy\nwith a romantic thread — its incoming\narc is over 3× larger than outgoing."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative", "scale": {"domain": [0, 800]}, "axis": null},
        "y": {"field": "y", "type": "quantitative", "scale": {"domain": [800, 0]}, "axis": null},
        "text": {"field": "label"}
      }
    },
    {
      "description": "Genre labels",
      "data": {
        "url": "data/chord_labels.csv",
        "format": {
          "type": "csv",
          "parse": {"label_x": "number", "label_y": "number"}
        }
      },
      "mark": {"type": "text", "fontSize": 13, "fontWeight": 600, "color": "#1a1a1a"},
      "encoding": {
        "x": {"field": "label_x", "type": "quantitative", "scale": {"domain": [0, 800]}, "axis": null},
        "y": {"field": "label_y", "type": "quantitative", "scale": {"domain": [800, 0]}, "axis": null},
        "text": {"field": "genre", "type": "nominal"}
      }
    }
  ]
}