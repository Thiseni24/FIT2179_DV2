{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Critics, Crowds and Cash",
    "subtitle": "Do highly rated films attract the most attention?",
    "anchor": "start",
    "fontSize": 33,
    "subtitleFontSize": 19,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Helvetica"
  },
  "width": 1000,
  "height": 490,
  "background": null,
  "config": {
    "view": {"stroke": null},
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#1a1a1a",
      "titleColor": "#6b6258",
      "labelFontSize": 11,
      "titleFontSize": 12
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#1a1a1a",
      "titleColor": "#1a1a1a"
    }
  },
  "data": {
    "url": "data/movies_joined.csv",
    "format": {
      "type": "csv",
      "parse": {
        "imdb_rating": "number",
        "num_raters": "number",
        "num_reviews": "number",
        "revenue": "number",
        "year": "number"
      }
    }
  },
  "params": [
    {
      "name": "country_filter",
      "value": "All",
      "bind": {
        "input": "select",
        "options": [
          "All",
          "United States of America",
          "United Kingdom",
          "France",
          "Japan",
          "Germany",
          "Italy",
          "Canada",
          "India",
          "South Korea",
          "Australia",
          "Spain"
        ],
        "name": "Filter by Country:  "
      }
    }
  ],
  "transform": [
    {
      "filter": "datum.imdb_rating != null && datum.num_raters != null && datum.revenue != null"
    },
    {
      "calculate": "indexof(['United States of America','United Kingdom','France','Japan','Germany','Italy','Canada','India','South Korea','Australia','Spain'], datum.primary_country) >= 0 ? datum.primary_country : 'Other'",
      "as": "Country"
    },
    {
      "filter": "country_filter == 'All' || datum.primary_country == country_filter"
    },
    {
      "joinaggregate": [
        {"op": "mean", "field": "num_raters", "as": "avg_raters_line"}
      ]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "opacity": 0.4,
        "stroke": "beige",
        "strokeWidth": 0.5
      },
      "encoding": {
        "x": {
          "field": "imdb_rating",
          "type": "quantitative",
          "scale": {"domain": [0, 10]},
          "axis": {
            "title": "IMDb Rating",
            "grid": true,
            "gridColor": "#ebe1d2",
            "gridDash": [2, 3],
            "tickCount": 6
          }
        },
        "y": {
          "field": "num_raters",
          "type": "quantitative",
          "scale": {"type": "log", "domain": [10000, 3000000]},
          "axis": {
            "title": "Number of Raters",
            "format": ",.0s",
            "grid": true,
            "gridColor": "#ebe1d2",
            "gridDash": [2, 3]
          }
        },
        "size": {
          "field": "revenue",
          "type": "quantitative",
          "scale": {"range": [50, 950]},
          "legend": {
            "title": "Revenue (USD)",
            "orient": "right",
            "titleFontSize": 13,
            "labelFontSize": 11,
            "format": "$,.0s"
          }
        },
        "color": {
          "field": "Country",
          "type": "nominal",
          "scale": {
            "domain": [
              "United States of America",
              "United Kingdom",
              "France",
              "Japan",
              "Germany",
              "Italy",
              "Canada",
              "India",
              "South Korea",
              "Australia",
              "Spain",
              "Other"
            ],
            "range": [
              "#bcbd8b",
              "#9c89b8",
              "#D4C08D",
              "#5d2e46",
              "#847577",
              "#C99B95",
              "#a39171",
              "#bd632f",
              "#618985",
              "#3b3355",
              "#a5a58d",
              "#DCD8CF"
            ]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 13,
            "labelFontSize": 11,
            "symbolType": "circle"
          }
        },
        "tooltip": [
          {"field": "title_ieee", "type": "nominal", "title": "Film"},
          {"field": "year_ieee", "type": "quantitative", "title": "Year"},
          {"field": "primary_country", "type": "nominal", "title": "Country"},
          {"field": "imdb_rating", "type": "quantitative", "title": "IMDb Rating", "format": ".1f"},
          {"field": "num_raters", "type": "quantitative", "title": "Number of Raters", "format": ","},
          {"field": "num_reviews", "type": "quantitative", "title": "Number of Reviews", "format": ","},
          {"field": "revenue", "type": "quantitative", "title": "Revenue", "format": "$,.2s"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [6, 4],
        "strokeWidth": 1.5,
        "color": "#6b6258"
      },
      "encoding": {
        "x": {"datum": 7}
      }
    },
    {
      "mark": {
        "type": "rule",
        "strokeDash": [6, 4],
        "strokeWidth": 1.5,
        "color": "#6b6258"
      },
      "encoding": {
        "y": {"field": "avg_raters_line", "type": "quantitative"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 8.7, "y": 4200000, "label": "Acclaimed\nBlockbusters"},
          {"x": 8.7, "y": 18000, "label": "Hidden\nGems"},
          {"x": 1.1, "y": 4200000, "label": "Popular but\nDivisive"},
          {"x": 1.1, "y": 18000, "label": "Forgotten\nFilms"}
        ]
      },
      "mark": {
        "type": "text",
        "font": "Inter",
        "fontSize": 12,
        "fontWeight": "700",
        "color": "#6b6258",
        "align": "left",
        "baseline": "middle",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {"x1": 6.1, "y1": 420000, "x2": 2.7, "y2": 1200000}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "y": {"field": "y1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 2.3, "x2": 4.6, "y": 750000, "y2": 1860000}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 2.43,
            "y": 1600000,
            "label": "Controversial films often attract \nlarge numbers of ratings because \naudiences are motivated to share \nboth praise and criticism."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 13,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}