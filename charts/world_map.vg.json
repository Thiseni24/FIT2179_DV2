{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "A Map of Modern Cinema",
    "subtitle": "Where the world's films are made",
    "anchor": "start",
    "fontSize": 27,
    "subtitleFontSize": 18,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Helvetica"  
  },
  "width": 1000,
  "height": 500,
  "background": null,
  "config": {
    "view": {"stroke": null},
    "font": "Inter"
  },
  "projection": {"type": "equalEarth"},
  "layer": [
    {
      "data": {"sphere": true},
      "mark": {
        "type": "geoshape",
        "fill": "#A8CBDD"
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e2d5",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      }
    },
    {
      "data": {
        "url": "https://cdn.jsdelivr.net/npm/world-atlas@2/countries-110m.json",
        "format": {"type": "topojson", "feature": "countries"}
      },
      "transform": [
        {
          "lookup": "properties.name",
          "from": {
            "data": {"url": "data/films_by_country.csv"},
            "key": "country",
            "fields": ["film_count", "avg_rating", "total_revenue"]
          }
        },
        {
          "filter": "datum.film_count != null && datum.film_count > 0"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "#ffffff",
        "strokeWidth": 0.5
      },
      "encoding": {
        "color": {
          "field": "film_count",
          "type": "quantitative",
          "scale": {
            "type": "log",
            "range": ["#edddd4", "#e26d5c", "#a44a3f", "#772e25"],
            "interpolate": "lab"
          },
          "legend": {
            "title": "Number of Films Produced",
            "orient": "bottom",
            "direction": "horizontal",
            "gradientLength": 320,
            "offset": 20,
            "titleFontSize": 11,
            "labelFontSize": 10
          }
        },
        "tooltip": [
          {
            "field": "properties.name",
            "type": "nominal",
            "title": "Country"
          },
          {
            "field": "film_count",
            "type": "quantitative",
            "title": "Number of Films",
            "format": ","
          },
          {
            "field": "avg_rating",
            "type": "quantitative",
            "title": "Average Rating",
            "format": ".2f"
          },
          {
            "field": "total_revenue",
            "type": "quantitative",
            "title": "Total Revenue (USD)",
            "format": "$,.0f"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"lon1": 78, "lat1": 15, "lon2": 70, "lat2": -2}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.3
      },
      "encoding": {
        "longitude": {"field": "lon1", "type": "quantitative"},
        "latitude": {"field": "lat1", "type": "quantitative"},
        "longitude2": {"field": "lon2"},
        "latitude2": {"field": "lat2"}
      }
    },
    {
      "data": {
        "values": [
          {"lon": 52.5, "lon2": 100, "lat": -16.5, "lat2": -2}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#dcd4c9",
        "stroke": "#c0b7aa",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "longitude2": {"field": "lon2"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "latitude2": {"field": "lat2"}
      }
    },
    {
      "data": {
        "values": [
          {
            "lon": 53,
            "lat": -5,
            "label": "India's diverse regional \nfilm industries fuel its \nhigh production levels."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 10.5,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "longitude": {"field": "lon", "type": "quantitative"},
        "latitude": {"field": "lat", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}