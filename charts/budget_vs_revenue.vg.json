{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Does a Bigger Budget Mean a Bigger Hit?",
    "subtitle": "Exploring the relationship between production spending and box-office success",
    "anchor": "start",
    "fontSize": 30,
    "subtitleFontSize": 18,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Inter"
  },
  "width": 700,
  "height": 480,
  "background": null,
  "config": {
    "view": {"stroke": null},
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#1a1a1a",
      "titleColor": "#6b6258",
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  },
  "layer": [
    {
      "description": "Break-even diagonal line (revenue = budget)",
      "data": {
        "values": [
          {"x": 1000, "y": 1000},
          {"x": 500000000, "y": 500000000}
        ]
      },
      "mark": {
        "type": "line",
        "color": "#d4a548",
        "strokeDash": [4, 4],
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"}
      }
    },
    {
      "description": "Each film as a dot",
      "data": {
        "url": "data/tmdb.csv",
        "format": {
          "type": "csv",
          "parse": {
            "budget": "number",
            "revenue": "number",
            "vote_average": "number",
            "year": "number"
          }
        }
      },
      "transform": [
        {"filter": "datum.budget >= 1000"},
        {"filter": "datum.revenue > 0"},
        {"calculate": "datum.revenue / datum.budget", "as": "roi"},
        {"calculate": "datum.revenue > datum.budget ? 'Profit' : 'Loss'", "as": "outcome"}
      ],
      "mark": {
        "type": "circle",
        "size": 35,
        "opacity": 0.5
      },
      "encoding": {
        "x": {
          "field": "budget",
          "type": "quantitative",
          "scale": {"type": "log"},
          "axis": {
            "title": "Budget (USD, log scale)",
            "format": "$,.0s",
            "grid": true,
            "gridColor": "#ebe1d2",
            "gridDash": [2, 3]
          }
        },
        "y": {
          "field": "revenue",
          "type": "quantitative",
          "scale": {"type": "log"},
          "axis": {
            "title": "Box Office Revenue (USD, log scale)",
            "format": "$,.0s",
            "grid": true,
            "gridColor": "#ebe1d2",
            "gridDash": [2, 3]
          }
        },
        "color": {
          "field": "outcome",
          "type": "nominal",
          "scale": {
            "domain": ["Profit", "Loss"],
            "range": ["#6b8e4e", "#780116"]  
          },
          "legend": {
            "title": "Outcome",
            "orient": "right",
            "titleFontSize": 11,
            "labelFontSize": 11,
            "symbolSize": 120,
            "symbolOpacity": 0.7
          }
        },
        "tooltip": [
          {"field": "title", "type": "nominal", "title": "Film"},
          {"field": "year", "type": "quantitative", "title": "Year"},
          {"field": "budget", "type": "quantitative", "title": "Budget", "format": "$,.0f"},
          {"field": "revenue", "type": "quantitative", "title": "Revenue", "format": "$,.0f"},
          {"field": "roi", "type": "quantitative", "title": "Return on Investment", "format": ".2f"},
          {"field": "vote_average", "type": "quantitative", "title": "Average Rating", "format": ".2f"},
          {"field": "tmdb_primary_genre", "type": "nominal", "title": "Genre"},
          {"field": "primary_country", "type": "nominal", "title": "Country"}
        ]
      }
    },
    {
      "description": "Connector line to annotation",
      "data": {
        "values": [
          {
            "x1": 25000,
            "y1": 105000000,
            "x2": 10000,
            "y2": 200000000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#6b6258",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y1", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "description": "Connector line to annotation",
      "data": {
        "values": [
          {
            "x1": 60000,
            "y1": 240000000,
            "x2": 31000,
            "y2": 700000000
          }
        ]
      },
      "mark": {
        "type": "rule",
        "stroke": "#6b6258",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y1", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "description": "Annotation box",
      "data": {
        "values": [
          {
            "x1": 1500,
            "x2": 31000,
            "y1": 200000000,
            "y2": 7000000000
          }
        ]
      },
      "mark": {
        "type": "rect",
        "cornerRadius": 6,
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y1", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "description": "Annotation text",
      "data": {
        "values": [
          {
            "x": 1700,
            "y": 4300000000
          }
        ]
      },
      "mark": {
        "type": "text",
        "text": [
          "The rise of viral internet",
          "marketing allowed some",
          "films to reach global",
          "audiences without massive",
          "promotional budgets."
        ],
        "align": "left",
        "baseline": "middle",
        "fontSize": 11,
        "lineHeight": 14,
        "fill": "#6b6258",
        "font": "Inter"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"}
      }
    }
  ]
}