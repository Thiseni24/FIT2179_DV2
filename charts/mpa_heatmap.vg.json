{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "title": {
    "text": "Inside Movie Certifications",
      "subtitle": [
        "Comparing popularity, audience ratings, and runtimes",
        "across different certification levels"
      ],
    "anchor": "start",
    "fontSize": 92,
    "subtitleFontSize": 45,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Inter"
  },

  "width": 1200,
  "height": 1200,
  "padding": {"left": 5, "right": 100, "top": 5, "bottom": 5},

  "data": {
    "url": "data/movies_joined.csv"
  },

  "transform": [
    {
      "filter": "datum.mpaa != null && datum.mpaa != '' && datum.mpaa != 'Null' && datum.mpaa != 'Not Rated' && datum.mpaa != 'Unrated'"
    },
    {
      "joinaggregate": [{"op": "count", "as": "MovieCount"}],
      "groupby": ["mpaa"]
    },
    {
      "filter": "datum.MovieCount >= 10"
    },
    {
      "aggregate": [
        {"op": "mean", "field": "popularity", "as": "Average Popularity"},
        {"op": "mean", "field": "imdb_rating", "as": "Average IMDb Rating"},
        {"op": "mean", "field": "runtime_min", "as": "Average Runtime"},
        {"op": "count", "as": "Number of Titles"}
      ],
      "groupby": ["mpaa"]
    },
    {
      "fold": ["Average Popularity", "Average IMDb Rating", "Average Runtime"],
      "as": ["Metric", "Value"]
    },
    {
      "joinaggregate": [
        {"op": "min", "field": "Value", "as": "MinValue"},
        {"op": "max", "field": "Value", "as": "MaxValue"}
      ],
      "groupby": ["Metric"]
    },
    {
      "calculate": "(datum.Value - datum.MinValue) / (datum.MaxValue - datum.MinValue)",
      "as": "NormalisedValue"
    },
    {
      "calculate": "datum.Metric == 'Average Runtime' ? format(datum.Value, '.1f') + ' min' : format(datum.Value, '.1f')",
      "as": "ValueLabel"
    }
  ],

  "layer": [
    {
      "mark": {
        "type": "rect",
        "cornerRadius": 15,
        "stroke": "#f5f5f5",
        "strokeWidth": 2
      },
      "encoding": {
        "x": {
          "field": "Metric",
          "type": "nominal",
          "sort": ["Average Popularity", "Average IMDb Rating", "Average Runtime"],
          "axis": {
            "title": null,
            "labelAngle": 0,
            "labelFontSize": 40,
            "labelLimit": 260,
            "labelExpr": "datum.label == 'Average Popularity' ? ['Average', 'Popularity'] : datum.label == 'Average IMDb Rating' ? ['Average IMDb', 'Rating'] : ['Average', 'Runtime']"
          }
        },
        "y": {
          "field": "mpaa",
          "type": "ordinal",
          "axis": {
            "title": "Movie Certification",
            "labelFontSize": 40,
            "titleFontSize": 40,
            "titlePadding": 20
          }
        },
        "color": {
          "field": "NormalisedValue",
          "type": "quantitative",
          "scale": {
            "range": ["#eae0d5", "#c6ac8f", "#5e503f"]
          },
          "legend": {
            "title": ["Relative", "Average"],
            "titleFontSize": 40,
            "labelFontSize": 35,
            "gradientLength": 500,
            "gradientThickness": 24
          }
        },
        "tooltip": [
          {"field": "mpaa", "title": "Certification"},
          {"field": "Metric"},
          {"field": "Value", "title": "Average Value", "format": ".2f"},
          {"field": "Number of Titles", "title": "Number of Titles"}
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "fontSize": 40,
        "fontWeight": "bold",
        "color": "black"
      },
      "encoding": {
        "x": {
          "field": "Metric",
          "type": "nominal",
          "sort": ["Average Popularity", "Average IMDb Rating", "Average Runtime"]
        },
        "y": {"field": "mpaa", "type": "ordinal"},
        "text": {"field": "ValueLabel"}
      }
    }
  ],

  "config": {
    "view": {"stroke": null},
    "axis": {
      "domain": false,
      "tickColor": "#cccccc"
    }
  }
}