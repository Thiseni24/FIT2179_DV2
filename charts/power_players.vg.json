{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "The Studios That Rule the Box Office",
    "subtitle": "Comparing studio output, revenue, and earning power",
    "anchor": "start",
    "fontSize": 30,
    "subtitleFontSize": 13,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Inter"
  },
  "width": 700,
  "height": 430,
  "background": null,
  "data": {
    "url": "data/tmdb.csv",
    "format": {
      "type": "csv",
      "parse": {
        "revenue": "number",
        "budget": "number",
        "vote_average": "number",
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.revenue > 0 && datum.primary_company != null && datum.primary_company != ''"
    },
    {
      "filter": "datum.year >= 1970 && datum.year <= 2024"
    },
    {
      "aggregate": [
        {"op": "sum", "field": "revenue", "as": "total_revenue"},
        {"op": "count", "field": "title", "as": "film_count"},
        {"op": "mean", "field": "vote_average", "as": "avg_rating"}
      ],
      "groupby": ["primary_company", "primary_country"]
    },
    {
      "calculate": "datum.total_revenue / 1000000000",
      "as": "revenue_billions"
    },
    {
      "calculate": "datum.total_revenue / datum.film_count / 1000000",
      "as": "avg_revenue_per_film"
    },
    {
      "window": [{"op": "rank", "as": "rank"}],
      "sort": [{"field": "total_revenue", "order": "descending"}]
    },
    {
      "filter": "datum.rank <= 20"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "circle",
        "filled": true,
        "color": "#5c724a",
        "opacity": 0.8,
        "stroke": "grey",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "film_count",
          "type": "quantitative",
          "title": "Number of Films",
          "axis": {
            "grid": true,
            "gridColor": "#eadfce",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "y": {
          "field": "revenue_billions",
          "type": "quantitative",
          "title": "Total Revenue (Billion USD)",
          "axis": {
            "grid": true,
            "gridColor": "#eadfce",
            "labelFontSize": 11,
            "titleFontSize": 12
          }
        },
        "size": {
          "field": "avg_revenue_per_film",
          "type": "quantitative",
          "title": "Average Revenue per Film (Million USD)",
          "scale": {"range": [150, 3500]},
          "legend": {
            "orient": "right",
            "title": "Revenue per Film"
          }
        },
        "tooltip": [
          {"field": "primary_company", "title": "Studio"},
          {"field": "primary_country", "title": "Country"},
          {"field": "film_count", "title": "Number of Films", "format": ","},
          {"field": "revenue_billions", "title": "Total Revenue (Billion USD)", "format": ".2f"},
          {"field": "avg_revenue_per_film", "title": "Revenue per Film (Million USD)", "format": ".1f"},
          {"field": "avg_rating", "title": "Average Rating", "format": ".2f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"x1": 116, "y1": 32.0, "x2": 148, "y2": 32.0}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.4
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "y": {"field": "y1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 148, "x2": 208, "y": 29.0, "y2": 33.0}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 151,
            "y": 32,
            "label": "Disney's revenue was greatly \nboosted by their acquisition of \nMarvel, Pixar and Lucasfilm."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 11,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Inter",
    "axis": {
      "domain": false,
      "tickColor": "#cfc3b4",
      "labelColor": "#1a1a1a",
      "titleColor": "#6b6258"
    }
  }
}