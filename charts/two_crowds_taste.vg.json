{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Two Crowds, Similar Taste",
    "subtitle": "How two major film communities judge the same eras of cinema",
    "anchor": "start",
    "fontSize": 37,
    "subtitleFontSize": 20,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Helvetica"
  },
  "width": 600,
  "height": 400,
  "background": null,
  "data": {
    "url": "data/movies_joined.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year_ieee": "number",
        "imdb_rating": "number",
        "vote_average": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year_ieee >= 1970 && datum.year_ieee <= 2024 && datum.imdb_rating > 0 && datum.vote_average > 0"
    },
    {
      "calculate": "floor(datum.year_ieee / 10) * 10",
      "as": "decade_start"
    },
    {
      "calculate": "datum.decade_start + 's'",
      "as": "decade"
    },
    {
      "aggregate": [
        { "op": "mean", "field": "imdb_rating", "as": "IMDb" },
        { "op": "mean", "field": "vote_average", "as": "TMDB" },
        { "op": "count", "as": "film_count" }
      ],
      "groupby": ["decade", "decade_start"]
    },
    {
      "filter": "datum.film_count >= 5"
    },
    {
      "fold": ["IMDb", "TMDB"],
      "as": ["rating_source", "average_rating"]
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "rule",
        "color": "#6c584c",
        "strokeWidth": 1.5
      },
      "encoding": {
        "x": {
          "field": "rating_source",
          "type": "nominal",
          "sort": ["IMDb", "TMDB"]
        }
      }
    },
    {
      "mark": {
        "type": "line",
        "strokeWidth": 3,
        "opacity": 0.85
      },
      "encoding": {
        "x": {
          "field": "rating_source",
          "type": "nominal",
          "sort": ["IMDb", "TMDB"],
          "axis": {
            "title": null,
            "labelFontSize": 14,
            "labelFontWeight": "bold",
            "labelAngle": 0
          }
        },
        "y": {
          "field": "average_rating",
          "type": "quantitative",
          "scale": { "domain": [6.8, 8.0] },
          "axis": {
            "title": "Average Rating",
            "grid": true,
            "gridColor": "#ebe1d2",
            "gridDash": [2, 3],
            "labelFontSize": 14
          }
        },
        "color": {
          "value": "#414833"
        },
        "detail": { "field": "decade" },
        "tooltip": [
          { "field": "decade", "title": "Decade" },
          { "field": "rating_source", "title": "Rating Source" },
          { "field": "average_rating", "title": "Average Rating", "format": ".2f" },
          { "field": "film_count", "title": "Films Compared", "format": "," }
        ]
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 90,
        "opacity": 0.9
      },
      "encoding": {
        "x": {
          "field": "rating_source",
          "type": "nominal",
          "sort": ["IMDb", "TMDB"]
        },
        "y": {
          "field": "average_rating",
          "type": "quantitative",
          "scale": { "domain": [6.8, 8.0] }
        },
        "color": {
          "value": "#414833"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rating_source == 'IMDb'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -10,
        "fontSize": 13,
        "fontWeight": "bold",
        "font": "Inter",
        "color": "#6b6258"
      },
      "encoding": {
        "x": {
          "field": "rating_source",
          "type": "nominal",
          "sort": ["IMDb", "TMDB"]
        },
        "y": {
          "field": "average_rating",
          "type": "quantitative",
          "scale": { "domain": [6.8, 8.0] }
        },
        "text": {
          "field": "decade"
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.rating_source == 'TMDB'"
        }
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 10,
        "fontSize": 13,
        "fontWeight": "bold",
        "font": "Inter",
        "color": "#6b6258"
      },
      "encoding": {
        "x": {
          "field": "rating_source",
          "type": "nominal",
          "sort": ["IMDb", "TMDB"]
        },
        "y": {
          "field": "average_rating",
          "type": "quantitative",
          "scale": { "domain": [6.8, 8.0] }
        },
        "text": {
          "field": "decade"
        }
      }
    },
    {
      "data": {
        "values": [
          {"x1": "IMDb", "y1": 7.81, "x2": "TMDB", "y2": 7.88}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.2
      },
      "encoding": {
        "x": {"field": "x1", "type": "nominal", "sort": ["IMDb", "TMDB"]},
        "y": {"field": "y1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"value": 315},
        "x2": {"value": 526},
        "y": {"value": 3},
        "y2": {"value": 76.0}
      }
    },
    {
      "data": {
        "values": [
          {
            "label": "Many classic films remain \nrelevant and highly rated \nthrough ongoing restoration \nand re-releases."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "top",
        "font": "Inter",
        "fontSize": 14.5,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n"
      },
      "encoding": {
        "x": {"value": 325},
        "y": {"value": 9},
        "text": {"field": "label"}
      }
    }
  ],
  "config": {
    "view": { "stroke": null },
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#1a1a1a",
      "titleColor": "#6b6258",
      "domain": false,
      "ticks": false
    }
  }
}