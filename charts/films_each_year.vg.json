{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": [
      "The Boom and Bust of Global Film",
      "Production"
    ],
    "subtitle": [
      "A timeline of cinema's rapid expansion and post-pandemic",
      "slowdown"
    ],
    "anchor": "start",
    "fontSize": 33.5,
    "subtitleFontSize": 20.5,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Helvetica"
  },
  "width": 560,
  "height": 390,
  "background": null,
  "config": {
    "view": {"stroke": null},
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#1a1a1a",
      "titleColor": "#6b6258",
      "labelFontSize": 13,
      "titleFontSize": 16,
      "domain": false,
      "ticks": false,
      "grid": false
    }
  },
  "data": {
    "url": "data/tmdb.csv",
    "format": {
      "type": "csv",
      "parse": {
        "year": "number"
      }
    }
  },
  "transform": [
    {
      "filter": "datum.year >= 1970 && datum.year <= 2024"
    }
  ],
  "layer": [
    {
      "data": {
        "values": [
          {"year": 2020, "year2": 2024, "y": 0, "y2": 1300}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#861a1e",
        "opacity": 0.08
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {"domain": [1970, 2024]}
        },
        "x2": {"field": "year2"},
        "y": {"field": "y", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "mark": {
        "type": "line",
        "color": "#8C564B",
        "strokeWidth": 3,
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {"domain": [1970, 2024]},
          "axis": {
            "title": "Release Year",
            "format": "d",
            "grid": true,
            "gridColor": "#ebe1d2",
            "gridDash": [2, 3]
          }
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "axis": {
            "title": "Number of Films",
            "grid": true,
            "gridColor": "#ebe1d2",
            "gridDash": [2, 3]
          }
        },
        "tooltip": [
          {
            "field": "year",
            "type": "quantitative",
            "title": "Year",
            "format": "d"
          },
          {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Number of Films"
          }
        ]
      }
    },
    {
      "data": {
        "values": [
          {"x1": 2020, "y1": 910, "x2": 2010, "y2": 1100}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.3
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "y": {"field": "y1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 1989, "x2": 2010, "y": 970, "y2": 1230}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1990,
            "y": 1177,
            "label": "COVID-19 forced productions\nto shut down globally, delaying \nreleases and reducing film \noutput after years of growth."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 13.5,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n",
        "lineHeight": 16
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "mark": {
        "type": "point",
        "filled": true,
        "size": 200,
        "opacity": 0
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {"domain": [1970, 2024]}
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative"
        },
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"aggregate": "count", "type": "quantitative", "title": "Number of Films"}
        ]
      }
    }
  ]
}