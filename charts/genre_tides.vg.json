{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Genre Tides in Global Cinema",
    "subtitle": "Tracking the changing popularity of cinema's biggest genres over five decades",
    "anchor": "start",
    "fontSize": 30,
    "subtitleFontSize": 18,
    "subtitleColor": "#6b6258",
    "font": "Playfair Display",
    "subtitleFont": "Inter"
  },
  "width": 1000,
  "height": 430,
  "background": null,
  "params": [
    {
      "name": "GenreFilter",
      "bind": {
        "input": "select",
        "options": ["All", "Drama", "Comedy", "Action", "Horror", "Animation", "Thriller", "Crime", "Other"],
        "name": "Filter Genre:  "
      },
      "value": "All"
    }
  ],
  "config": {
    "view": {"stroke": null},
    "font": "Inter",
    "axis": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelColor": "#1a1a1a",
      "titleColor": "#6b6258",
      "labelFontSize": 11,
      "titleFontSize": 11,
      "domain": false,
      "ticks": false,
      "grid": false
    },
    "legend": {
      "labelFont": "Inter",
      "titleFont": "Inter",
      "labelFontSize": 11,
      "titleFontSize": 12
    }
  },
  "data": {
    "url": "data/tmdb.csv",
    "format": {
      "type": "csv",
      "parse": {"year": "number"}
    }
  },
  "transform": [
    {"filter": "datum.year >= 1970 && datum.year <= 2024 && datum.tmdb_primary_genre != null"},
    {
      "calculate": "indexof(['Drama','Comedy','Action','Horror','Animation','Thriller','Crime'], datum.tmdb_primary_genre) >= 0 ? datum.tmdb_primary_genre : 'Other'",
      "as": "genre_grouped"
    },
    {"filter": "GenreFilter == 'All' || datum.genre_grouped == GenreFilter"}
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "interpolate": "monotone"
      },
      "encoding": {
        "x": {
          "field": "year",
          "type": "quantitative",
          "scale": {"domain": [1970, 2024]},
          "axis": {
            "title": "Release Year",
            "format": "d",
            "grid": true,
            "gridColor": "#ebe1d2",
            "gridDash": [2, 3]
          }
        },
        "y": {
          "aggregate": "count",
          "type": "quantitative",
          "stack": "center",
          "axis": null
        },
        "color": {
          "field": "genre_grouped",
          "type": "nominal",
          "title": "Genre",
          "scale": {
            "domain": ["Drama", "Comedy", "Action", "Horror", "Animation", "Thriller", "Crime", "Other"],
            "range": ["#7a2e3e", "#ffd380", "#d65a1f", "#2c2c2c", "#7FB8A4", "#3a4d6c", "#2d6166", "#9b9085"]
          },
          "legend": {
            "orient": "right",
            "titleFontSize": 12,
            "labelFontSize": 11
          }
        },
        "tooltip": [
          {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
          {"field": "genre_grouped", "type": "nominal", "title": "Genre"},
          {"aggregate": "count", "type": "quantitative", "title": "Number of Films"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"x1": 2013, "y1": 130, "x2": 2010, "y2": 100}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.4
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "y": {"field": "y1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 1990, "x2": 2010, "y": 170, "y2": -50}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1991,
            "y": 138,
            "label": "Thriller Films that blended suspense with \nsocial commentary helped thrillers appeal to \nwider audiences, driving the genre's \nresurgence during the 2010s."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 10.5,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    },
    {
      "data": {
        "values": [
          {"x1": 2009, "y1": 980, "x2": 2003, "y2": 1050}
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#6b6258",
        "strokeWidth": 1.4
      },
      "encoding": {
        "x": {"field": "x1", "type": "quantitative"},
        "y": {"field": "y1", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {"x": 1985.4, "x2": 2003, "y": 1240, "y2": 1000}
        ]
      },
      "mark": {
        "type": "rect",
        "fill": "#f4ede4",
        "stroke": "#d8cfc1",
        "strokeWidth": 1,
        "cornerRadius": 6,
        "opacity": 0.97
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "x2": {"field": "x2"},
        "y": {"field": "y", "type": "quantitative"},
        "y2": {"field": "y2"}
      }
    },
    {
      "data": {
        "values": [
          {
            "x": 1986,
            "y": 1200,
            "label": "Advances in visual effects and \nthe rise of blockbuster franchises \nhelped action movies attract audiences \nacross languages and cultures."
          }
        ]
      },
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        "font": "Inter",
        "fontSize": 10.5,
        "fontWeight": "normal",
        "color": "#6b6258",
        "lineBreak": "\n",
        "lineHeight": 14
      },
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "label"}
      }
    }
  ]
}